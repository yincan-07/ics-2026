# As you've got familiar with Y86 after writting your first y86 code
# (bubble.ys), this code is left blank for you :)
	.pos 0
	irmovq	stack,%rsp
	call main
	halt

	#设置初始链表
    .align 8
ele1:
    .quad 0x00a
    .quad ele2
ele2:
    .quad 0x0b0
    .quad ele3
ele3:
    .quad 0xc00
    .quad 0
	
################################################################################
# You may want to modify this portion

rsum:
    pushq %rbp
    irmovq $0, %rax
    andq %rdi, %rdi
    je end
    mrmovq 0(%rdi),%rbp
    mrmovq 8(%rdi),%rdi
    call rsum
    addq %rbp, %rax
end:
    popq %rbp
    ret

    



#main function
main:
	irmovq	ele1, %rdi
    call rsum
    ret


	.pos 0x200
stack:
