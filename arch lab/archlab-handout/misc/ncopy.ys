################################################################################
# ncopy.ys - 把 src 指向的 len 个字复制到 dst，并返回 src 中正数的个数。
#
# 姓名：尹璨    学号：2500012789
#
# 一、原始代码的问题
#   基线版本在循环里对每个元素都执行一条条件跳转（val <= 0 时 jle Npos）。
#   本流水线对所有跳转一律预测“跳转”，因此该分支几乎每次都被误预测，
#   基线每元素约 13 个周期中的绝大部分都消耗在误预测清空流水线的气泡上。
#
# 二、我的做法：数据通路完全无分支
#   每个元素固定执行 6 条指令，把“复制”和“判断是否为正数并计数”合并成
#   一条没有任何控制相关的指令流：
#       mrmovq  val, src      # 读取元素
#       rmmovq  val, dst      # 写回元素
#       xorq    tmp, tmp      # tmp = 0
#       andq    val, val      # 设置条件码：G 成立当且仅当 val > 0
#       cmovg   one, tmp      # val > 0 时 tmp = 1，否则 tmp 仍为 0
#       addq    tmp, count    # count += tmp
#   用 cmovg + addq 取代“条件跳转 + 自增”，彻底消除了数据相关的分支误预测。
#
# 三、循环展开 16 次
#   - 每个半块先集中发射 8 条 mrmovq，再开始使用这些寄存器，因此“装载值”
#     第一次被使用时已在 8 条指令之后，load/use 冒险永远不会触发停顿。
#   - 采用常量偏移 0、8、…、120 寻址，src/dst/len 三个量每 16 个元素才更新
#     一次（用 iaddq / isubq，即架构里新增的 IOPQ 指令），循环控制开销只有
#     4 条指令 / 16 个元素。
#
# 四、尾部处理（处理不足 16 个的剩余元素）
#   - 剩余元素用 8、4、2、1 元素的直线代码块依次处理，没有内层循环；
#   - len < 8 时直接分派到“长度恰好为 len 的完全展开块”，避免短数组还要
#     走一遍通用尾循环，从而压低小规模输入的固定开销。
#
# 五、配套架构（ncopy.hcl）
#   在五级流水线基础上加入 IOPQ 立即数运算指令类，并让条件码寄存器晚一级
#   写入（用 M 级已寄存的 ALU 操作数/结果）。语义完全等价，但打断了
#   alu -> reg_cc -> cond 这条组合路径，把架构代价 ac 从 4 降到 3。
#
################################################################################
ncopy:
################################################################################
# You can modify this portion
        xorq %rax,%rax          # count = 0
        irmovq $1,%rbp          # %rbp = 1 (used by cmovg)
        isubq $8,%rdx
        jl Tiny                 # len < 8
        isubq $8,%rdx
        jl Mid8                 # 8 <= len <= 15
        jmp Main

#-------------------------------------------------------------------------------
# Main loop: 16 elements per iteration.
#-------------------------------------------------------------------------------
Main:
        mrmovq 0(%rdi),%r8
        mrmovq 8(%rdi),%r9
        mrmovq 16(%rdi),%r10
        mrmovq 24(%rdi),%r11
        mrmovq 32(%rdi),%r12
        mrmovq 40(%rdi),%r13
        mrmovq 48(%rdi),%r14
        mrmovq 56(%rdi),%rbx
        rmmovq %r8,0(%rsi)
        xorq %rcx,%rcx
        andq %r8,%r8
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %r9,8(%rsi)
        xorq %rcx,%rcx
        andq %r9,%r9
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %r10,16(%rsi)
        xorq %rcx,%rcx
        andq %r10,%r10
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %r11,24(%rsi)
        xorq %rcx,%rcx
        andq %r11,%r11
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %r12,32(%rsi)
        xorq %rcx,%rcx
        andq %r12,%r12
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %r13,40(%rsi)
        xorq %rcx,%rcx
        andq %r13,%r13
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %r14,48(%rsi)
        xorq %rcx,%rcx
        andq %r14,%r14
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %rbx,56(%rsi)
        xorq %rcx,%rcx
        andq %rbx,%rbx
        cmovg %rbp,%rcx
        addq %rcx,%rax
        mrmovq 64(%rdi),%r8
        mrmovq 72(%rdi),%r9
        mrmovq 80(%rdi),%r10
        mrmovq 88(%rdi),%r11
        mrmovq 96(%rdi),%r12
        mrmovq 104(%rdi),%r13
        mrmovq 112(%rdi),%r14
        mrmovq 120(%rdi),%rbx
        rmmovq %r8,64(%rsi)
        xorq %rcx,%rcx
        andq %r8,%r8
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %r9,72(%rsi)
        xorq %rcx,%rcx
        andq %r9,%r9
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %r10,80(%rsi)
        xorq %rcx,%rcx
        andq %r10,%r10
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %r11,88(%rsi)
        xorq %rcx,%rcx
        andq %r11,%r11
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %r12,96(%rsi)
        xorq %rcx,%rcx
        andq %r12,%r12
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %r13,104(%rsi)
        xorq %rcx,%rcx
        andq %r13,%r13
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %r14,112(%rsi)
        xorq %rcx,%rcx
        andq %r14,%r14
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %rbx,120(%rsi)
        xorq %rcx,%rcx
        andq %rbx,%rbx
        cmovg %rbp,%rcx
        addq %rcx,%rax
        iaddq $128,%rdi
        iaddq $128,%rsi
        isubq $16,%rdx
        jge Main

        iaddq $16,%rdx          # rdx = len % 16 (0..15)
        andq %rdx,%rdx
        jle Done
        isubq $8,%rdx
        jl Add8
        jmp Copy8

#-------------------------------------------------------------------------------
# 8 <= len <= 15: copy eight, then the 0..7 remainder
#-------------------------------------------------------------------------------
Mid8:   iaddq $16,%rdx          # rdx = len (8..15)
        isubq $8,%rdx           # rdx = len - 8 (0..7)
Copy8:
        mrmovq 0(%rdi),%r8
        mrmovq 8(%rdi),%r9
        mrmovq 16(%rdi),%r10
        mrmovq 24(%rdi),%r11
        mrmovq 32(%rdi),%r12
        mrmovq 40(%rdi),%r13
        mrmovq 48(%rdi),%r14
        mrmovq 56(%rdi),%rbx
        rmmovq %r8,0(%rsi)
        xorq %rcx,%rcx
        andq %r8,%r8
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %r9,8(%rsi)
        xorq %rcx,%rcx
        andq %r9,%r9
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %r10,16(%rsi)
        xorq %rcx,%rcx
        andq %r10,%r10
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %r11,24(%rsi)
        xorq %rcx,%rcx
        andq %r11,%r11
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %r12,32(%rsi)
        xorq %rcx,%rcx
        andq %r12,%r12
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %r13,40(%rsi)
        xorq %rcx,%rcx
        andq %r13,%r13
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %r14,48(%rsi)
        xorq %rcx,%rcx
        andq %r14,%r14
        cmovg %rbp,%rcx
        addq %rcx,%rax
        rmmovq %rbx,56(%rsi)
        xorq %rcx,%rcx
        andq %rbx,%rbx
        cmovg %rbp,%rcx
        addq %rcx,%rax
        iaddq $64,%rdi
        iaddq $64,%rsi
        andq %rdx,%rdx
        jle Done
        jmp Rem

Add8:   iaddq $8,%rdx           # rdx = 0..7
        jmp Rem

Tiny:   iaddq $8,%rdx           # rdx = len (0..7)
        isubq $1,%rdx
        je  F1
        isubq $1,%rdx
        je  F2
        isubq $1,%rdx
        je  F3
        isubq $1,%rdx
        je  F4
        isubq $1,%rdx
        je  F5
        isubq $1,%rdx
        je  F6
        isubq $1,%rdx
        je  F7
        iaddq $7,%rdx
        jmp Rem

F1:
        mrmovq 0(%rdi),%r8
        rmmovq %r8,0(%rsi)
        xorq %rcx,%rcx
        andq %r8,%r8
        cmovg %rbp,%rcx
        addq %rcx,%rax
        ret

F2:
        mrmovq 0(%rdi),%r8
        mrmovq 8(%rdi),%r9
        rmmovq %r8,0(%rsi)
        rmmovq %r9,8(%rsi)
        xorq %rcx,%rcx
        andq %r8,%r8
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r9,%r9
        cmovg %rbp,%rcx
        addq %rcx,%rax
        ret

F3:
        mrmovq 0(%rdi),%r8
        mrmovq 8(%rdi),%r9
        mrmovq 16(%rdi),%r10
        rmmovq %r8,0(%rsi)
        rmmovq %r9,8(%rsi)
        rmmovq %r10,16(%rsi)
        xorq %rcx,%rcx
        andq %r8,%r8
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r9,%r9
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r10,%r10
        cmovg %rbp,%rcx
        addq %rcx,%rax
        ret

F4:
        mrmovq 0(%rdi),%r8
        mrmovq 8(%rdi),%r9
        mrmovq 16(%rdi),%r10
        mrmovq 24(%rdi),%r11
        rmmovq %r8,0(%rsi)
        rmmovq %r9,8(%rsi)
        rmmovq %r10,16(%rsi)
        rmmovq %r11,24(%rsi)
        xorq %rcx,%rcx
        andq %r8,%r8
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r9,%r9
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r10,%r10
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r11,%r11
        cmovg %rbp,%rcx
        addq %rcx,%rax
        ret

F5:
        mrmovq 0(%rdi),%r8
        mrmovq 8(%rdi),%r9
        mrmovq 16(%rdi),%r10
        mrmovq 24(%rdi),%r11
        mrmovq 32(%rdi),%r12
        rmmovq %r8,0(%rsi)
        rmmovq %r9,8(%rsi)
        rmmovq %r10,16(%rsi)
        rmmovq %r11,24(%rsi)
        rmmovq %r12,32(%rsi)
        xorq %rcx,%rcx
        andq %r8,%r8
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r9,%r9
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r10,%r10
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r11,%r11
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r12,%r12
        cmovg %rbp,%rcx
        addq %rcx,%rax
        ret

F6:
        mrmovq 0(%rdi),%r8
        mrmovq 8(%rdi),%r9
        mrmovq 16(%rdi),%r10
        mrmovq 24(%rdi),%r11
        mrmovq 32(%rdi),%r12
        mrmovq 40(%rdi),%r13
        rmmovq %r8,0(%rsi)
        rmmovq %r9,8(%rsi)
        rmmovq %r10,16(%rsi)
        rmmovq %r11,24(%rsi)
        rmmovq %r12,32(%rsi)
        rmmovq %r13,40(%rsi)
        xorq %rcx,%rcx
        andq %r8,%r8
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r9,%r9
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r10,%r10
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r11,%r11
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r12,%r12
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r13,%r13
        cmovg %rbp,%rcx
        addq %rcx,%rax
        ret

F7:
        mrmovq 0(%rdi),%r8
        mrmovq 8(%rdi),%r9
        mrmovq 16(%rdi),%r10
        mrmovq 24(%rdi),%r11
        mrmovq 32(%rdi),%r12
        mrmovq 40(%rdi),%r13
        mrmovq 48(%rdi),%r14
        rmmovq %r8,0(%rsi)
        rmmovq %r9,8(%rsi)
        rmmovq %r10,16(%rsi)
        rmmovq %r11,24(%rsi)
        rmmovq %r12,32(%rsi)
        rmmovq %r13,40(%rsi)
        rmmovq %r14,48(%rsi)
        xorq %rcx,%rcx
        andq %r8,%r8
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r9,%r9
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r10,%r10
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r11,%r11
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r12,%r12
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r13,%r13
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r14,%r14
        cmovg %rbp,%rcx
        addq %rcx,%rax
        ret


#-------------------------------------------------------------------------------
# 0..7 remaining elements: straight-line 4 + 2 + 1 blocks
#-------------------------------------------------------------------------------
Rem:    isubq $4,%rdx
        jge Do4                 # taken when at least four are left
        iaddq $4,%rdx           # rdx = 0..3
        isubq $2,%rdx
        jge Do2b
        iaddq $2,%rdx           # rdx = 0..1
        andq %rdx,%rdx
        jle Done
        jmp One

Do2b:
        mrmovq 0(%rdi),%r8
        mrmovq 8(%rdi),%r9
        rmmovq %r8,0(%rsi)
        rmmovq %r9,8(%rsi)
        xorq %rcx,%rcx
        andq %r8,%r8
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r9,%r9
        cmovg %rbp,%rcx
        addq %rcx,%rax
        iaddq $16,%rdi
        iaddq $16,%rsi
        isubq $1,%rdx
        jl Done
        jmp One

Do4:
        mrmovq 0(%rdi),%r8
        mrmovq 8(%rdi),%r9
        mrmovq 16(%rdi),%r10
        mrmovq 24(%rdi),%r11
        rmmovq %r8,0(%rsi)
        rmmovq %r9,8(%rsi)
        rmmovq %r10,16(%rsi)
        rmmovq %r11,24(%rsi)
        xorq %rcx,%rcx
        andq %r8,%r8
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r9,%r9
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r10,%r10
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r11,%r11
        cmovg %rbp,%rcx
        addq %rcx,%rax
        iaddq $32,%rdi
        iaddq $32,%rsi
        isubq $2,%rdx
        jge Do2a
        iaddq $2,%rdx
        andq %rdx,%rdx
        jle Done
        jmp One

Do2a:
        mrmovq 0(%rdi),%r8
        mrmovq 8(%rdi),%r9
        rmmovq %r8,0(%rsi)
        rmmovq %r9,8(%rsi)
        xorq %rcx,%rcx
        andq %r8,%r8
        cmovg %rbp,%rcx
        addq %rcx,%rax
        xorq %rcx,%rcx
        andq %r9,%r9
        cmovg %rbp,%rcx
        addq %rcx,%rax
        iaddq $16,%rdi
        iaddq $16,%rsi
        isubq $1,%rdx
        jl Done
        jmp One

One:    mrmovq 0(%rdi),%r8
        rmmovq %r8,0(%rsi)
        xorq %rcx,%rcx
        andq %r8,%r8
        cmovg %rbp,%rcx
        addq %rcx,%rax

Done:   ret

# In grader, we will add a "trap: jmp trap" here, which traps your program in an
# infinite loop. Thus your function should always return instead of falling
# through till the end of the source code :)
